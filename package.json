{
  "name": "code1",
  "version": "0.1.0",
  "type": "module",
  "description": "村口大战外星人 - 单局肉鸽制角色改造自走战斗（微信/抖音小游戏）",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/sim.ts",
    "bundle": "vite build",
    "build:wechat": "CODE1_PLATFORM=wechat vite build",
    "build:douyin": "CODE1_PLATFORM=douyin vite build",
    "build": "npm run typecheck && npm run test && vite build",
    "dev": "vite build --watch",
    "lab": "vite --config tools/anim-lab/vite.config.ts"
  },
  "dependencies": {
    "@gp/analytics-sdk": "file:../game-analysis/packages/analytics-sdk",
    "@pixi/unsafe-eval": "^7.3.2",
    "pixi.js": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
