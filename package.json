{
  "name": "code1",
  "version": "0.1.0",
  "type": "module",
  "description": "代号1 - 单局肉鸽制英雄编队自走防守（微信/抖音小游戏）",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/sim.ts",
    "bundle": "vite build",
    "build:wechat": "CODE1_PLATFORM=wechat vite build",
    "build:douyin": "CODE1_PLATFORM=douyin vite build",
    "build": "npm run typecheck && npm run test && vite build",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^7.3.2",
    "pixi.js": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
